# noctoprevi - contoh integrasi hypridle
#
# Dua cara memakainya:
#
#   A. Salin manual
#      - salin blok di bawah ke ~/.config/hypr/hypridle.conf
#      - muat ulang: hyprctl reload
#
#   B. Biarkan program menuliskannya (disarankan)
#      noctoprevi install --idle-daemon hypridle
#      hyprctl reload
#      Blok punya penanda "# >>> noctoprevi >>>" sehingga aman di-uninstall
#      dan tidak menimpa setting lain yang sudah kamu punya.
#
# Yang terjadi:
#   300 detik tanpa input   ->  screensaver video menyala fullscreen
#   ada input mouse/keyboard ->  screensaver mati, layar langsung normal
#   900 detik tanpa input   ->  lockscreen Noctalia terkunci
#
# Kenapa screensaver dimatikan lewat on-resume, bukan on-timeout:
#   Agar layar tidak berkedip. Satu listener dengan timeout=0 tidak
#   pernah memicu on-timeout, tapi on-resume tetap dipanggil begitu
#   ada input. Jadi audio/video langsung berhenti di saat yang tepat.
#
# Catatan latensi:
#   Urutan on-resume di hypridle dijalankan berurutan, jadi letakkan
#   listener ini paling atas di file hypridle.conf kalau kamu punya
#   listener lain yang lambat. Target kembalinya ke layar normal
#   di bawah 150 ms; ukur sendiri dengan: noctoprevi bench

# >>> noctoprevi >>>
# Generated by noctoprevi 1.0.0 - jangan diedit di dalam blok ini.
# Di-generate ulang dengan: noctoprevi install --idle-daemon hypridle

listener {
    timeout = 300
    on-timeout = noctoprevi start
}

listener {
    timeout = 900
    on-timeout = noctalia msg lock
}

listener {
    timeout = 0
    on-resume = noctoprevi stop
}
# <<< noctoprevi <<<
